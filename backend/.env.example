PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
# Optional. Without this, the API serves clearly labeled demo data.
DATABASE_URL=
# Only set after Booking.com grants Guest Review API permission to your machine account.
BOOKING_API_TOKEN=
# Comma-separated internal property codes and numeric Booking.com property IDs.
BOOKING_REVIEW_PROPERTY_IDS=
# Defaults to 2000-01-01 (full history). Narrow this only if your sync process tracks a safe overlap window.
BOOKING_REVIEW_FROM_DATE=2000-01-01
